  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webazarashi/mori-webhook-relay.git"
  },
  "homepage": "https://github.com/webazarashi/mori-webhook-relay#readme",
  "bugs": {
    "url": "https://github.com/webazarashi/mori-webhook-relay/issues"
  },
  "author": "Takuya Matsuzaki",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "login": "node scripts/login.mjs",
    "inspect": "node scripts/inspect.mjs",
    "dry-run": "node scripts/dry-run.mjs",
    "bench": "node scripts/bench.mjs",
